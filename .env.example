# ---- Redis (state shared between the CLI and the background worker) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---- Korail ----
# Seconds between searches (default 3). Faster polling gets the IP flagged as a macro.
SEARCH_INTERVAL=3
# Minutes Korail keeps an unpaid reservation (used for reminders/timeouts)
PAYMENT_TIMEOUT_MINUTES=10
# Seconds between KakaoTalk payment reminders while a reservation is unpaid
PAYMENT_REMINDER_INTERVAL=120

# Optional: pin the DynaPath device identity. If unset, one is generated and saved to
# KORAIL_DEVICE_FILE (default ~/.korail_bot_device.json) so every process shares it.
# KORAIL_DEVICE_PROFILE_ID=
# KORAIL_ANDROID_ID=
# KORAIL_DEVICE_FILE=

# ---- Automatic card payment ----
# Offer paying with the saved card right after a reservation succeeds (korailbot card set).
AUTO_PAYMENT_ENABLED=True
# Key for encrypting the saved card and Korail credentials in Redis (AES-256-GCM).
# Generate with: openssl rand -hex 32   If unset, a random key is created once in
# ~/.korail_bot/secret.key - keep that file, losing it means re-registering the card.
# CARD_ENCRYPTION_KEY=

# ---- KakaoTalk notifications ("나에게 보내기") ----
# 1. https://developers.kakao.com 에서 앱 생성 -> REST API 키
# 2. 카카오 로그인 활성화, Redirect URI 등록: http://localhost:8080/kakao/oauth
# 3. 동의항목에서 "카카오톡 메시지 전송(talk_message)" 활성화
# 4. korailbot kakao link
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=            # 앱에서 Client Secret을 '사용함'으로 켠 경우에만
# KAKAO_LOCAL_PORT=8080           # kakao link 가 인증 응답을 받을 로컬 포트
# KAKAO_REDIRECT_URI=             # 비우면 http://localhost:${KAKAO_LOCAL_PORT}/kakao/oauth

# ---- Local files / logging ----
# KORAIL_BOT_DATA_DIR=~/.korail_bot      # worker logs (logs/), secret.key
LOG_LEVEL=INFO
