# Telegram Bot Configuration
BOTTOKEN=your_telegram_bot_token_here

# Korail Admin Credentials
USERID=your_korail_id_here
USERPW=your_korail_password_here

# User Access Control (comma-separated phone numbers)
# Leave empty to allow all users
ALLOW_LIST=010-1234-5678,010-9876-5432

# Redis Configuration (don't change these if using docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Optional: Redis password (uncomment if needed)
# REDIS_PASSWORD=your_redis_password

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=8080
# Keep False in production: debug mode exposes the Werkzeug debugger on FLASK_HOST
FLASK_DEBUG=False

# Public URL of this server (scheme + host, no trailing slash). Needed for OAuth redirects.
# PUBLIC_BASE_URL=https://bot.example.com

# KakaoTalk integration (optional). Users link their Kakao account with /kakao and receive
# reservation results / payment deadline alerts in KakaoTalk "나와의 채팅".
# 1. https://developers.kakao.com 에서 앱 생성 -> REST API 키
# 2. 카카오 로그인 활성화, Redirect URI 등록 (기본값: {PUBLIC_BASE_URL}/kakao/oauth)
# 3. 동의항목에서 "카카오톡 메시지 전송(talk_message)" 활성화
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=            # 앱에서 Client Secret을 '사용함'으로 켠 경우에만
# KAKAO_REDIRECT_URI=             # 비우면 {PUBLIC_BASE_URL}/kakao/oauth

# Korail search interval in seconds (default 3). Faster polling gets the IP flagged as a macro.
SEARCH_INTERVAL=3

# Optional: pin the DynaPath device identity. If unset, one is generated and saved to KORAIL_DEVICE_FILE
# (default ~/.korail_bot_device.json) so the web app and background processes share it.
# KORAIL_DEVICE_PROFILE_ID=
# KORAIL_ANDROID_ID=
# KORAIL_DEVICE_FILE=/app/data/korail_device.json

# Payment Timeout (minutes)
PAYMENT_TIMEOUT_MINUTES=10

# Offer automatic card payment in the reservation flow (card details are collected per
# reservation, handed to the search process via its environment and never kept in Redis
# beyond the conversation). Set False to hide the step entirely.
AUTO_PAYMENT_ENABLED=True

# Logging
LOG_LEVEL=INFO
