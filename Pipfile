[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Versions match requirements.txt (the set verified against Korail). pykorail itself lives in src/pykorail;
# certifi, curl-cffi and pycryptodome are its dependencies.
requests = "==2.34.2"
certifi = "==2026.10.23"
curl-cffi = "==0.16.3"
pycryptodome = "==4.2.0"
redis = "==8.1.0"
hiredis = "==3.5.0"

[dev-packages]
pytest = "*"
pytest-cov = "*"
pytest-mock = "*"
freezegun = "*"
testcontainers = {extras = ["redis"], version = "*"}

[requires]
python_version = "3.12"
